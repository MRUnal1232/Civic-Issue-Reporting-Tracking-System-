{
  "name": "civic-issue-tracker",
  "version": "1.0.0",
  "description": "A comprehensive civic issue reporting and tracking system",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "civic",
    "issues",
    "reporting",
    "tracking",
    "react",
    "nodejs"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "cloudinary": "^2.7.0",
    "dotenv": "^17.2.2",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2"
  }
}
